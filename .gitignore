# Dependencies -------------------------------------------------------------
# No leading slash, so this matches at any depth: backend/node_modules,
# userapp/node_modules, vendor-website/node_modules, admin-panel/node_modules.
node_modules/


# Secrets ------------------------------------------------------------------
#
# THIS REPOSITORY IS PUBLIC. backend/.env holds live credentials - the MongoDB
# connection string (which contains its own password), the Razorpay key secret
# and webhook secret, the Cloudinary API secret, the JWT signing secret, the
# Brevo API key and the Google OAuth client secret. Any one of those reaching a
# public commit is a breach, and git history is effectively permanent once
# pushed: forks, clones and GitHub's own caches keep a copy even after a force
# push.
#
# `.env` with no slash matches at every depth, which is what covers
# backend/.env, userapp/.env, vendor-website/.env and admin-panel/.env.
# `.env.*` then catches the variants a deployment adds later
# (.env.production, .env.staging, .env.local) so a new one is ignored by
# default rather than needing someone to remember.
.env
.local-media/
.env.*

# ...except the templates, which are the documentation and contain no values.
!.env.example
!**/.env.example

# Service-account and key files, in case any are ever added locally.
*.pem
*.p8
*.p12
*.key
*.jks
*.keystore
*-service-account*.json
google-services.json
GoogleService-Info.plist


# Build output -------------------------------------------------------------
dist/
build/
web-build/
*.tsbuildinfo


# Expo / React Native ------------------------------------------------------
.expo/
.metro-health-check*
# Generated native projects - regenerated by `expo prebuild`.
/userapp/ios
/userapp/android
*.orig.*


# Logs and local runtime ---------------------------------------------------
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
pids
*.pid


# Editors and OS -----------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
*.swp

# VS Code: keep shared settings committable, ignore per-machine state.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json


# Test and tooling artefacts -----------------------------------------------
coverage/
.nyc_output/

# Local design references and agent working copies
.codex/
