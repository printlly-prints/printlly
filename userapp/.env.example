# Base URL of the backend Express API (no trailing slash).
# NOTE: "localhost" will NOT work on a physical phone - the phone resolves
# localhost to itself, not your PC. Use your computer's LAN IP instead,
# e.g. http://192.168.1.5:5000
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.5:5000

# No Razorpay key belongs here any more. The app used to read its own
# EXPO_PUBLIC_RAZORPAY_KEY_ID and trust its own checkout result - see
# PaymentScreen.js. Now POST /payments/razorpay/create-order returns the
# key id (and the server-computed amount) at checkout time, and nothing
# is trusted until POST /payments/razorpay/verify checks the payment
# signature server-side. See the root .env.example for RAZORPAY_KEY_ID/
# RAZORPAY_KEY_SECRET.

# Support contact details shown on the Help & Support screen. Both are
# REQUIRED before release: with either missing, the app falls back to an
# obviously fake address/number AND shows a "placeholder details" warning
# on the screen, which is deliberate - see src/config/support.js. Fill in
# the real support inbox and phone line here; do not copy these examples.
# EXPO_PUBLIC_SUPPORT_EMAIL=support@yourdomain.com
# EXPO_PUBLIC_SUPPORT_PHONE=+91 98765 43210
# Optional. Shown under the phone number; defaults to "10 AM - 7 PM, Mon to Sat".
# EXPO_PUBLIC_SUPPORT_HOURS=10 AM - 7 PM, Mon to Sat


# ---------------------------------------------------------------------------
# Observability  (OPTIONAL - PUBLIC, write-only credential)
# ---------------------------------------------------------------------------
# Expo INLINES every EXPO_PUBLIC_ variable into the JavaScript bundle, so an
# EXPO_PUBLIC_ variable is PUBLISHED, not configured. Anyone who has the app
# can read it. Never put a server secret here - see the repository root
# .env.example for the full list.

# PostHog PROJECT api key (phc_...). Designed to be public.
# Unset = no analytics at all; every trackEvent call becomes a no-op.
#
# Autocapture and session replay are FORCED OFF in code and cannot be enabled
# by configuration. React Native autocapture sends the accessibility label or
# text of whatever was touched, which on the order screens is a shop name and
# an uploaded document's filename - and session replay records the screen,
# which shows the customer's documents and their pickup code.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# WHICH EVENTS THIS APP SENDS (src/lib/analytics.js):
#   app_opened, shop_viewed, document_upload_started, payment_started,
#   signup_started
#
# Only what the server cannot know - intent and navigation. Everything
# authoritative (order_created, payment_completed, order_ready,
# order_completed) is emitted by the BACKEND, because only the backend knows
# it actually happened. Emitting payment_completed from here would count
# payments that never completed.
#
# NOTE on signup_started: it will not fire in a built binary. The customer
# sign-in flow is development-only (see src/constants/demoAuth.js) and any
# real build shows AuthUnavailableScreen instead, so there is no signup to
# start. The call is wired where it belongs and becomes correct the moment a
# real sign-in flow exists.
#
# THERE IS NO CRASH-REPORTING SDK IN THIS APP. @sentry/react-native contains
# native code and needs a config plugin plus an EAS build, and app.json has no
# EAS project id yet - the same gap that blocks push notifications. Adding it
# would break the Expo Go workflow and could not be verified by any build this
# repository can currently run. src/components/ErrorBoundary.js keeps a JS
# render error from becoming a blank screen in the meantime, and counts it as
# one analytics event.
