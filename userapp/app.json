{
  "expo": {
    "name": "Printlly",
    "slug": "printlly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/printlly-mark.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F7FAFA"
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#087F8C"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Printlly uses your location to show how far each print shop is and list the nearest ones first."
        }
      ]
    ]
  }
}
