{
  "expo": {
    "name": "Paprout",
    "slug": "printlly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/paprout-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/paprout-adaptive.png",
        "monochromeImage": "./assets/paprout-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/paprout-favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/paprout-mark.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#FAFAF7"
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/paprout-monochrome.png",
          "color": "#007C9C"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Paprout uses your location to show how far each print shop is and list the nearest ones first."
        }
      ]
    ]
  }
}
