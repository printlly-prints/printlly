# Base URL of the backend Express API (no trailing slash)
VITE_API_BASE_URL=http://localhost:5000

# Customer app download links, shown on /auth/get-app. All placeholders
# until the app is actually published - leave unset and the page falls
# back to disabled store badges / a QR code pointing at this site.
VITE_APP_DOWNLOAD_URL=
VITE_GOOGLE_PLAY_URL=
VITE_APP_STORE_URL=

# ---------------------------------------------------------------------------
# Legal / business identity  (REQUIRED before publishing the legal pages)
# ---------------------------------------------------------------------------
# The pages at /terms, /privacy, /refund-policy, /grievance and the rest read
# these. Until VITE_LEGAL_BUSINESS_NAME, VITE_REGISTERED_ADDRESS and
# VITE_SUPPORT_EMAIL are all set, every legal page renders a visible
# "Draft - business details not yet configured" banner and shows
# [PLACEHOLDERS] instead of contact details.
#
# Nothing here has been invented. Fill in the real registered details.
# A wrong address on a grievance page reads as a working one, and a customer
# who writes to it gets silence rather than a bounce.
VITE_LEGAL_BUSINESS_NAME=
VITE_REGISTERED_ADDRESS=
VITE_SUPPORT_EMAIL=
VITE_SUPPORT_PHONE=
VITE_SUPPORT_HOURS=

# Optional. Each falls back to VITE_SUPPORT_EMAIL when unset.
VITE_GRIEVANCE_EMAIL=
VITE_LEGAL_EMAIL=

# Platform GSTIN. Shown on /payment-billing. Leave blank until a real one
# exists - the page says plainly that GST invoices are not issued and that
# the GSTIN is not configured, rather than displaying a made-up number.
VITE_GSTIN=

# State whose courts have jurisdiction, named in the Terms.
VITE_GOVERNING_STATE=


# ---------------------------------------------------------------------------
# Observability  (OPTIONAL - both are PUBLIC, write-only credentials)
# ---------------------------------------------------------------------------
# Vite INLINES every VITE_ variable into the JavaScript it serves, so a VITE_
# variable is PUBLISHED, not configured. Only credentials that are designed to
# be readable by anyone with the page may go here.
#
# NEVER put any of these in this file: BREVO_API_KEY, TEAMS_WEBHOOK_URL,
# RAZORPAY_KEY_SECRET, RAZORPAY_WEBHOOK_SECRET, MONGODB_URI,
# UPSTASH_REDIS_REST_TOKEN, JWT_SECRET, or a PostHog PERSONAL api key
# (phx_...). Those are server-only - see the repository root .env.example.

# Sentry DSN for the DASHBOARD's own Sentry project - not the backend's.
# A DSN is write-only: it can send events, it cannot read your issues.
# Use a separate project from the backend and the admin panel, so a vendor's
# browser error and a payment webhook failure are not in one issue stream.
#
# Unset = no error reporting, and the @sentry/react chunk is never even
# downloaded (it is loaded with a dynamic import - see src/lib/observability.js).
VITE_SENTRY_DSN=

# PostHog PROJECT api key (phc_...). Designed to be public.
# Unset = no analytics, and the posthog-js chunk is never downloaded.
#
# Autocapture and session replay are both FORCED OFF in code and cannot be
# enabled by configuration. This dashboard renders customer documents, so a
# DOM recording would be a recording of other people's files, and autocapture
# would send the text of every element clicked - including document filenames.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://eu.i.posthog.com

# Labels errors and events by deployment and build. Default: "development" /
# "production" from the build mode, and the version below.
VITE_ENVIRONMENT=
VITE_APP_RELEASE=
