# Base URL of the backend API. The admin panel talks to the same server
# the vendor dashboard and mobile app do - it just uses the /admin/*
# routes, which require a JWT with role "admin".
VITE_API_BASE_URL=http://localhost:5000


# ---------------------------------------------------------------------------
# Observability  (OPTIONAL - PUBLIC, write-only credential)
# ---------------------------------------------------------------------------
# Vite INLINES every VITE_ variable into the JavaScript it serves, so a VITE_
# variable is PUBLISHED, not configured. Never put a server secret here -
# see the repository root .env.example for the full list.

# Sentry DSN for the ADMIN PANEL's own Sentry project - not the backend's and
# not the dashboard's. A DSN is write-only: it can send events, it cannot read
# your issues.
#
# Unset = no error reporting, and the @sentry/react chunk is never even
# downloaded (it is loaded with a dynamic import - see src/lib/observability.js).
#
# THIS IS THE MOST PRIVACY-SENSITIVE OF THE THREE CLIENTS. The admin panel
# sees vendor KYC documents, payout details, every customer order and the
# support inbox. Scrubbing here is correspondingly stricter than the
# dashboard's: session replay, console breadcrumbs and click breadcrumbs are
# all dropped outright rather than filtered, and IFSC, PAN, GSTIN and
# account-number shapes are redacted by pattern.
VITE_SENTRY_DSN=

# There is deliberately NO PostHog key for the admin panel. PostHog measures
# how the PRODUCT is used by customers; this panel is used by a handful of
# internal staff, so events from it would measure employees and would pollute
# the same funnels the customer app and the dashboard feed.

VITE_ENVIRONMENT=
VITE_APP_RELEASE=
