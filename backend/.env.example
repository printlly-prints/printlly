# ===========================================================================
# THIS IS A TEMPLATE. IT MUST NEVER CONTAIN A REAL VALUE.
# ===========================================================================
#
# This file IS COMMITTED TO THE REPOSITORY, and the repository is public.
# backend/.env is the one that holds real credentials, and it is gitignored at
# every depth.
#
# Live credentials were found in this file and removed before the first push:
# the MongoDB connection string, the Cloudinary secret, the JWT secret, the
# Google OAuth secret, all three Razorpay secrets and the Brevo API key. They
# are still present in backend/.env, so nothing was lost - but if this file
# was ever shared, pasted or backed up while it held them, rotate every one of
# those credentials.
#
# To configure a deployment:   cp backend/.env.example backend/.env
# Then fill in backend/.env, never this file.
#
# ===========================================================================

# Template for .env - safe to commit. Copy to .env and fill in real values.
# Never put real credentials in this file.

# MongoDB connection string (Atlas or local).
# Include the database name in the URI, otherwise Mongoose defaults to "test".
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_URI=

# Cloudinary credentials, used for uploading customer print files.
# CLOUDINARY_CLOUD_NAME is the "Cloud name" shown on your Cloudinary
# dashboard - it is not a name you choose here.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Secret key used to sign JSON Web Tokens - use a long random string.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port the Express server listens on
PORT=5000

# Google OAuth - shop owner login only (the customer app still uses
# email/password). Get these from:
# Google Cloud Console > APIs & Services > Credentials > Create Credentials
# > OAuth client ID > Application type: Web application.
# Add GOOGLE_CALLBACK_URL below as an "Authorized redirect URI" there -
# it must match exactly, including http/https and any trailing slash.
# If any of these three are left unset, GET /auth/google responds with
# 501 instead of the server failing to start.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# Base URL of the shop-owner web dashboard. After Google login, the
# backend redirects the browser to <FRONTEND_URL>/auth/callback?code=...
FRONTEND_URL=http://localhost:5173

# Razorpay credentials (test mode keys start with rzp_test_).
# KEY_ID is also returned to the customer app so it can open Razorpay's
# checkout - that's expected, it's a publishable id. KEY_SECRET must
# never leave the server: it's what signs/verifies payments in
# controllers/paymentController.js, so treat it like JWT_SECRET.
# Get both from Razorpay Dashboard > Settings > API Keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# How long a document that was uploaded but NEVER attached to an order is
# kept before being deleted from Cloudinary (see
# utils/documentCleanup.js). A customer who picks a file and then closes
# the app has left a document on our storage they never asked us to keep;
# this window exists only so someone who backgrounds the app mid-checkout
# does not lose their file. Lower is better for privacy. Defaults to 24.
UPLOAD_ORPHAN_RETENTION_HOURS=24

# ---------------------------------------------------------------------------
# Security: CORS allowlist
# ---------------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call this API and to
# open a Socket.io connection to it. Exact origins only - scheme://host[:port],
# no trailing slash, no path, and never "*". Parsed and validated at startup:
# a malformed entry stops the server rather than being silently dropped.
#
# FRONTEND_URL (above) is added to this list automatically, since the server
# already redirects browsers there after Google login.
#
# Outside production (NODE_ENV != production) http://localhost:*,
# http://127.0.0.1:* and Expo's exp:// scheme are also accepted, so local
# development needs no configuration at all. In production that convenience
# is off and this variable is REQUIRED - booting with NODE_ENV=production and
# an empty allowlist fails deliberately rather than falling back to "*".
#
# Requests with no Origin header (the Expo app, curl, the e2e suite) are not
# affected by this: CORS is a browser mechanism and cannot gate non-browser
# clients. Those are protected by the JWT on every route.
CORS_ALLOWED_ORIGINS=https://dashboard.printlly.com,https://admin.printlly.com

# Only set this to true if the app ever starts authenticating with cookies.
# It does not today - the JWT travels in the Authorization header - and
# leaving it off means an allowlist mistake cannot be combined with ambient
# cookie auth. Defaults to false.
CORS_ALLOW_CREDENTIALS=false

# ---------------------------------------------------------------------------
# Security: reverse proxy
# ---------------------------------------------------------------------------
# How to determine a caller's real IP address, which is what the rate
# limiters fall back to for unauthenticated traffic.
#
# Leave unset (or "false") when the Node process is reached directly - which
# is the case today, there is no proxy config in this repo. Do NOT set this
# to "true" unless there really is a proxy in front: trusting
# X-Forwarded-For on a directly-exposed server lets any caller forge their
# own address and reset their own rate limit.
#
#   unset / false  no proxy; use the socket address
#   1              behind exactly one proxy (typical: Nginx, Render, Fly, ALB)
#   loopback       proxy running on this same machine
#   true           trust every hop (only when the proxy rewrites XFF itself)
#   10.0.0.1,...   trust these specific proxy addresses/CIDRs
TRUST_PROXY=

# ---------------------------------------------------------------------------
# Security: rate limiting
# ---------------------------------------------------------------------------
# Every policy below is optional - the defaults in middleware/rateLimit.js
# are the intended production values, and these exist so a deployment can
# tighten or relax one category without a code change. Each is a request
# count per window, keyed by authenticated user id where there is one and by
# IP only for anonymous traffic (so mobile carrier NAT does not make
# customers share a budget).
#
# Set to false to switch the limiters off entirely. Intended for the e2e
# suite, which drives hundreds of requests through a few accounts from one
# address. Never set this in production.
RATE_LIMIT_ENABLED=true

# Sign-in, registration and OAuth code exchange. Keyed by IP + the email
# being targeted. Default: 20 per 15 minutes.
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20

# Pickup-OTP verification (PATCH /orders/:id/complete), keyed per order.
# Only wrong codes count. The strictest policy in the system: it is what
# stops a six-digit code from being brute-forced. Default: 10 per 15 minutes.
RATE_LIMIT_OTP_WINDOW_MS=900000
RATE_LIMIT_OTP_MAX=10

# Document / photo / KYC uploads, per user. Default: 40 per 15 minutes.
RATE_LIMIT_UPLOAD_WINDOW_MS=900000
RATE_LIMIT_UPLOAD_MAX=40

# Order creation and payment calls, per user. Default: 60 per 15 minutes.
RATE_LIMIT_ORDER_WINDOW_MS=900000
RATE_LIMIT_ORDER_MAX=60

# Everything else: shop discovery, pricing, notifications, saved shops,
# support chat. Per user. Default: 600 per 15 minutes.
RATE_LIMIT_GENERAL_WINDOW_MS=900000
RATE_LIMIT_GENERAL_MAX=600

# Admin API, per admin user. Higher because the panel's list views fan out
# into several calls per page. Default: 1000 per 15 minutes.
RATE_LIMIT_ADMIN_WINDOW_MS=900000
RATE_LIMIT_ADMIN_MAX=1000

# ---------------------------------------------------------------------------
# Security: HTTP response headers (helmet)
# ---------------------------------------------------------------------------
# Helmet needs no configuration of its own - the policy is fixed in
# config/security.js, because the right headers for a JSON API are a property
# of the application, not of the deployment, and an env var per header would
# only create ways to deploy it wrong.
#
# NODE_ENV is the single switch that changes header behaviour:
#
#   NODE_ENV=production
#     - Strict-Transport-Security is sent (1 year, includeSubDomains, no
#       preload), so browsers refuse to talk to this host over plain http.
#     - CORS_ALLOWED_ORIGINS becomes REQUIRED (see above) and the localhost
#       development origins are no longer accepted.
#
#   anything else (including unset - the default)
#     - HSTS is NOT sent. A browser ignores it over http anyway, and
#       asserting it locally would pin every localhost dev server on every
#       port to https for a year the moment anyone ran local TLS.
#     - localhost / 127.0.0.1 / Expo origins are accepted.
#
# Every other header - CSP, X-Frame-Options, Referrer-Policy,
# X-Content-Type-Options, the Cross-Origin-* policies - is identical in both
# environments. Set this to "production" on any real deployment.
NODE_ENV=production

# Razorpay webhook secret. This is a DIFFERENT secret from RAZORPAY_KEY_SECRET
# above: Razorpay generates it when you register a webhook endpoint, and it is
# what signs the webhook request body. KEY_SECRET signs the client-side
# payment response. Swapping the two produces a signature that never matches.
#
# Get it from: Razorpay Dashboard > Settings > Webhooks > (your endpoint).
# Point that endpoint at:  https://<your-api-host>/payments/webhook
# and subscribe at least to:  payment.captured, payment.failed
#
# Why this matters: without the webhook, an order only becomes paid if the
# customer's app comes back and says so. If the WebView crashes or they close
# the app on Razorpay's success screen, the money is taken and the order sits
# at payment_status "created" forever - no OTP for the customer, nothing owed
# to the shop. The webhook is the server-to-server path that fixes that.
#
# If Razorpay is configured and NODE_ENV=production, leaving this unset makes
# the server REFUSE TO START - silently rejecting every payment confirmation
# while customers are charged is a worse failure than not booting. Outside
# production it only warns, and POST /payments/webhook answers 503.
#
# Never returned by any API response, and never logged.
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Push notifications (Expo Push Service)
# ---------------------------------------------------------------------------
# PROVIDER: Expo Push Service, via the expo-server-sdk package. Chosen because
# the customer app is an Expo app (app/, SDK 57) and Expo's service is the only
# option that needs no native module work, no google-services.json committed to
# this repo, and no provider credential shipped inside the app bundle.
#
# TOKEN FORMAT: ExponentPushToken[xxxxxxxxxxxxxxxxxxxxxx] - obtained by the app
# from expo-notifications and registered via POST /notifications/device-token.
# Stored per DEVICE in the devicetokens collection, never logged in full.
#
# SENDING NEEDS NO CREDENTIAL. Expo accepts an unauthenticated send to a valid
# push token, which is why there is no required variable here. The optional one
# below turns on Expo's enhanced security mode, where Expo REJECTS any send
# that does not carry the token - worth enabling in production so that someone
# who obtains a device token cannot send notifications as you.
#
# Create one with: npx expo whoami && npx expo token:create
EXPO_ACCESS_TOKEN=

# WHAT STILL HAS TO BE DONE OUTSIDE THIS FILE before push works in a real
# build - none of it is a backend setting, and without it the backend will
# happily "send" to tokens that were never issued:
#
#   1. userapp/app.json needs an EAS project id (extra.eas.projectId). There is
#      none today, and expo-notifications cannot mint a push token without it.
#      Run: npx eas init    (inside app/)
#   2. Android production builds need FCM credentials uploaded to Expo
#      (Expo relays through FCM; it is not a separate push network).
#      Run: npx eas credentials
#   3. iOS needs an Apple Push key, also uploaded to Expo via eas credentials.
#   4. Push does not work in the iOS Simulator or an Android emulator without
#      Play Services, and never works in Expo Go on Android for SDK 53+.
#      A physical device and a development build are required to see one
#      arrive.
#
# DEV vs PRODUCTION: the backend behaves identically in both - it reads live
# device tokens and sends. With no registered devices it does nothing at all
# (and logs "not attempted"), which is the state of this project today.


# ===========================================================================
# ===========================================================================
#   OBSERVABILITY AND THIRD-PARTY OPERATIONS
# ===========================================================================
# ===========================================================================
#
# EVERY VARIABLE BELOW IS PRIVATE AND SERVER-ONLY.
#
# Nothing in this section may ever be given to the mobile app, the vendor
# dashboard or the admin panel. Those three are compiled and shipped to
# devices and browsers, so anything embedded in them is readable by anyone who
# has the app or opens devtools - a "frontend secret" is not a secret.
#
# Each client has its own .env.example with its own PUBLIC keys:
#   vendor-website/.env.example   VITE_*           (vendor dashboard + site)
#   admin-panel/.env.example      VITE_*           (admin panel)
#   userapp/.env.example          EXPO_PUBLIC_*    (customer app)
#
# A Sentry DSN and a PostHog PROJECT key are the two exceptions by design -
# both are write-only credentials meant to be shipped, and each client carries
# its own. They are still separate values from the ones here: the backend's
# DSN must never be compiled into a client, because each client's own
# configuration decides its sample rate and scrubbing.
#
# EVERY INTEGRATION HERE IS OPTIONAL AND OFF WHEN UNCONFIGURED.
#
# That is a deliberate requirement, not a convenience. Printlly must keep
# taking orders when Sentry, Brevo, Teams, PostHog or Redis is unreachable, so
# a deployment that has not configured one must behave exactly as if that
# provider were down - which means the outage path is the same code path a
# developer runs every day.
#
# A setting that is present but MALFORMED does stop the boot, because a
# half-configured integration is a bug, and a bug found at startup costs a
# deploy while the same bug found during an incident costs the incident.
# See config/observability.js.


# ---------------------------------------------------------------------------
# Shared service identity - used by Sentry, Teams and PostHog alike
# ---------------------------------------------------------------------------
#
# So that a Teams card, a Sentry issue and a PostHog event all name the same
# deployment and the same build.

# Shown on alerts and attached to every error. Change it if you run more than
# one backend against one Sentry project.
SERVICE_NAME=printlly-backend

# The build identifier. Defaults to the version in package.json, which is
# fine for a single-version deployment; set it to a git SHA or a CI build
# number if you need to tell two deploys of the same version apart.
APP_RELEASE=


# ---------------------------------------------------------------------------
# 1. SENTRY  -  technical error reporting
# ---------------------------------------------------------------------------
#
# Sentry answers "what broke and where". It is NOT the alerting system (that
# is Teams, below) and NOT the analytics system (that is PostHog).
#
# USE A SEPARATE SENTRY PROJECT PER APPLICATION: printlly-backend,
# printlly-dashboard, printlly-admin. One project for all three produces a
# single issue stream in which a vendor's browser error and a payment webhook
# failure are mixed together, and no useful alert rule can be written over it.
#
# WHAT IS NEVER SENT, enforced in utils/sentry.js and utils/scrub.js rather
# than left to each call site: passwords and hashes, JWTs and session ids,
# pickup OTPs, document URLs and Cloudinary public ids, payment signatures and
# credentials, KYC and bank details, email addresses and phone numbers, and
# stack-frame local variables (a frame inside the login controller holds the
# plaintext password). Request headers are filtered by ALLOWLIST, so a header
# added by a future CDN is dropped by default rather than forwarded.
#
# The DSN is a write-only credential. It cannot be used to READ your issues,
# but it can be used to write junk into your quota, so it is kept out of the
# repository like anything else.
#
# Get it from: Sentry > your project > Settings > Client Keys (DSN)
SENTRY_DSN=

# Separates issues per deployment. Defaults to NODE_ENV.
SENTRY_ENVIRONMENT=

# Explicit off switch, for silencing Sentry locally without deleting the DSN.
# Unset means "on if a DSN is present".
SENTRY_ENABLED=

# Performance tracing, 0 to 1. Default 0 - OFF.
#
# Deliberately off: tracing every request is the fastest way to exhaust a paid
# plan, and this application's performance questions are better answered from
# MongoDB Atlas's own query metrics. Turn it to something small like 0.05 only
# while investigating a specific latency problem.
SENTRY_TRACES_SAMPLE_RATE=0

# Error sampling, 0 to 1. Default 1 - keep all of them. Errors are rare here
# and each one matters; lower this only if a single noisy bug is consuming
# quota faster than you can fix it.
SENTRY_SAMPLE_RATE=1


# ---------------------------------------------------------------------------
# 2. BREVO  -  transactional email
# ---------------------------------------------------------------------------
#
# ALL THREE ARE REQUIRED TOGETHER, or none. Setting only some stops the boot
# with a named error, because Brevo refuses a send from an unverified sender -
# so a partial configuration would fail on every single email instead of once
# at startup, which is far harder to diagnose.
#
# BREVO_API_KEY IS A SERVER SECRET. It can send mail as your domain. It must
# never appear in the mobile app, the dashboard or the admin panel.
#
# The sender address must be a verified sender or an authenticated domain in
# Brevo, otherwise every send is rejected.
# Get the key from: Brevo > SMTP and API > API Keys
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Printlly

# Where replies go. Defaults to BREVO_SENDER_EMAIL. Point it at a real
# monitored inbox - every email says "do not reply", but people reply anyway.
EMAIL_REPLY_TO=

# Explicit off switch. Unset means "on if all three above are set".
BREVO_ENABLED=true

# Per-send timeout. A slow mail provider must not hold a request open.
BREVO_TIMEOUT_MS=8000

# WHICH EMAILS EXIST (utils/email.js). Every one has a real trigger; none was
# written speculatively.
#   customer: order_confirmed, payment_failed, order_accepted, order_ready,
#             order_completed, order_expired, password_changed
#   vendor:   vendor_welcome, shop_approved, shop_rejected, vendor_new_order,
#             vendor_settlement_paid
#
# DELIBERATELY ABSENT, because the functionality does not exist:
#   account verification - there is no email-verification flow
#   password reset       - there is no forgot-password route; changing a
#                          password requires the current one
#   refund notification  - no refund is implemented anywhere in the backend,
#                          so an email claiming a refund was issued would be a
#                          false statement from the platform
#   admin operational    - critical alerting goes to Teams, which is built for
#                          it; a second copy by email is one more thing to mute
#
# THE PICKUP OTP IS NEVER IN AN EMAIL. It is the one secret proving the
# customer is at the counter, and email is longer-lived and more widely
# forwarded than the push notification it is already kept out of.
brevo


# ---------------------------------------------------------------------------
# 3. MICROSOFT TEAMS  -  critical alert destination
# ---------------------------------------------------------------------------
#
# Teams is where a human finds out. It is a DESTINATION, not a monitoring
# system - nothing asks Teams whether something is wrong.
#
# THE WEBHOOK URL IS THE CREDENTIAL. Anyone holding it can post to your
# channel. It must be https, it must never reach a client, and utils/scrub.js
# additionally redacts anything URL-shaped containing "webhook" so it cannot
# leak into a Sentry error message.
#
# HOW TO CREATE ONE: Microsoft has RETIRED Office 365 Connectors, so create a
# Power Automate workflow instead - Teams > the channel > ... > Workflows >
# "Post to a channel when a webhook request is received". The default card
# format this application sends is an Adaptive Card, which is what a Workflow
# expects. Set TEAMS_WEBHOOK_FORMAT=legacy only if you still have an old
# connector URL, otherwise every card silently fails to post.
TEAMS_WEBHOOK_URL=

# "legacy" sends the retired MessageCard format. Leave unset for Workflows.
TEAMS_WEBHOOK_FORMAT=

# Explicit off switch. Unset means "on if a webhook URL is present".
TEAMS_ALERTS_ENABLED=

# The quietest severity that reaches Teams. P0 | P1 | P2 | P3, default P1.
#
#   P0  Printlly is broken or losing money. Page now.
#   P1  Degraded. Someone should look today.
#   P2  A real handled error. Sentry only.
#   P3  Notable but expected. Logs only.
#
# This exists because alert fatigue is a failure mode, not a nuisance: a
# channel that fires on every ordinary 500 is muted within a week, and the P0
# that follows is seen the next morning. Ordinary application errors
# deliberately do NOT reach Teams - they go to Sentry, where a trend is
# visible without interrupting anyone. Set this to P0 to make the channel
# page-only.
ALERT_MIN_SEVERITY=P1

# How long an identical alert is suppressed after being sent. Without this, a
# failing dependency produces one card per failed request - hundreds of
# identical cards, and an unreadable channel during exactly the incident the
# channel exists for. Shared through Redis when Redis is configured, so four
# instances send one card between them rather than four.
ALERT_DEDUPE_WINDOW_MS=600000

TEAMS_TIMEOUT_MS=5000

# WHAT ALERTS AT WHICH SEVERITY (utils/alerts.js):
#   P0  MongoDB disconnected; backend failed to start; payment webhook
#       processing failed; Razorpay amount or currency mismatch;
#       authentication failing for everyone; uncaught exception
#   P1  Paid Razorpay order with no matching Printlly order; document cleanup
#       failing; Cloudinary uploads failing; email provider unavailable;
#       elevated 5xx rate; unhandled rejection; MongoDB reconnected
#
# NOT ALERTED ON PURPOSE: an invalid webhook signature. That endpoint is
# public, so a bad signature is something any stranger can produce at will -
# wiring it to an alert channel would hand them a way to flood your on-call
# channel from a curl loop, making the monitoring layer itself the attack
# surface.


# ---------------------------------------------------------------------------
# 4. POSTHOG  -  product analytics
# ---------------------------------------------------------------------------
#
# Product analytics only. Technical errors go to Sentry. Nothing in this
# application reads from PostHog or makes any decision based on it - it is
# write-only, and removing it would change no behaviour.
#
# The PROJECT API key (phc_...) is designed to be public and is what the
# clients use too. Do NOT put a PERSONAL API key (phx_...) here - that one can
# read and modify your project, and it is never needed for sending events.
#
# Get it from: PostHog > Settings > Project > Project API Key
POSTHOG_API_KEY=

# EU or US cloud. Must match where your project actually lives, or events are
# accepted by the wrong region and never appear.
POSTHOG_HOST=https://eu.i.posthog.com

POSTHOG_ENABLED=
POSTHOG_FLUSH_AT=20
POSTHOG_FLUSH_INTERVAL_MS=10000

# PRIVACY: properties are filtered by ALLOWLIST, not denylist
# (utils/analytics.js). Unlike an error - whose value is in its unexpected
# detail - every analytics property is intentional, so the permitted names are
# enumerated and everything else is dropped by default. A new field on an
# order cannot start flowing to PostHog because someone passed an extra
# object.
#
# Never sent: document contents, filenames or URLs; the pickup OTP; passwords;
# payment credentials; email, phone, name or address; customer location; shop
# names (shop_id is enough to segment by shop).
#
# The identity used is the Mongo user id - pseudonymous, and meaningless
# outside this database.


# ---------------------------------------------------------------------------
# 5. UPSTASH REDIS  -  shared ephemeral state
# ---------------------------------------------------------------------------
#
# WHY IT MATTERS: with per-process rate-limit counters, a configured limit of
# 20 becomes an effective limit of 20 x (number of instances), and the
# effective limit changes silently whenever the deployment scales. A shared
# store is what makes the configured number mean what it says.
#
# Addressed over Upstash's REST API, not the Redis wire protocol - no
# connection pool to exhaust, no reconnect storm after a network blip, no
# socket held open by an idle process. BOTH VALUES ARE REQUIRED TOGETHER.
#
# Setting REDIS_URL (a redis:// TCP URL) instead stops the boot with an
# explanation rather than being ignored: a deployment that sets it is
# expecting distributed rate limiting, and silently falling back to
# per-process counters would be a security regression discovered only under
# load.
#
# Get both from: Upstash console > your database > REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

REDIS_ENABLED=

# Short on purpose. Redis is in the request path for rate limiting, so a slow
# Redis must degrade to "no shared counter" quickly rather than holding every
# request open.
REDIS_TIMEOUT_MS=1500

# Namespaces keys, so staging and production can share one Upstash database.
REDIS_KEY_PREFIX=printlly

# WHAT REDIS HOLDS: rate-limit counters, alert suppression markers, caches and
# locks. NOTHING AUTHORITATIVE. MongoDB remains the source of truth for
# orders, payments, users, vendor balances and document ownership. The test:
# if losing the value could change what a customer is charged, who owns a
# document, or whether an order is paid, it belongs in MongoDB.
#
# FAILURE BEHAVIOUR (utils/redis.js) - every call returns null when Redis
# cannot answer, so each caller decides what that means:
#   rate limiting  -> degrades to per-process counters. NOT fail-closed:
#                     refusing all traffic because a counter store is
#                     unreachable is a self-inflicted outage.
#   alert dedupe   -> fails towards SENDING. A duplicate card beats a missed
#                     incident.
#   caching        -> falls through to MongoDB. Slower, still correct.
#   locks          -> fails towards running anyway, so only work that is safe
#                     to repeat is ever locked.
#
# Redis is deliberately NOT a hard dependency of GET /health/ready - losing it
# reduces protection, it does not stop the server serving.


# ---------------------------------------------------------------------------
# 6. CLOUDFLARE / REVERSE PROXY
# ---------------------------------------------------------------------------
#
# Putting Cloudflare in front of this API requires exactly ONE backend
# setting: TRUST_PROXY, already documented further up this file. Set it to 1
# when Cloudflare proxies the API hostname.
#
# WHY THIS MATTERS MORE THAN IT LOOKS: with TRUST_PROXY unset behind
# Cloudflare, every request appears to come from a Cloudflare edge IP, so all
# customers share one rate-limit bucket and the first busy minute locks
# everyone out. Set to "true" on a server that is NOT actually behind a proxy,
# any caller can forge X-Forwarded-For and reset their own rate limit at will.
# Neither failure is visible without looking for it.
#
# Everything else Cloudflare provides - TLS, WAF, DDoS protection, bot
# management, caching rules - is dashboard configuration and needs no code.
# See docs/CLOUDFLARE.md for the required settings, and in particular for
# which paths must never be cached.


# ---------------------------------------------------------------------------
# 7. UPTIMEROBOT / HEALTH MONITORING
# ---------------------------------------------------------------------------
#
# No configuration. Two endpoints exist to be monitored:
#
#   GET /health        liveness. Touches nothing, always 200 if the process
#                      is serving. This is what an uptime monitor should
#                      watch, because it goes red only when the server is
#                      genuinely unreachable.
#   GET /health/ready  readiness. Pings MongoDB and checks required config.
#                      503 when it cannot serve.
#
# Both are unauthenticated - a monitor has no credentials and could not be
# given any safely - so both responses are deliberately minimal: no
# hostnames, no driver errors, no versions, no stack traces. The detail an
# operator needs goes to the log and to Sentry, both already authenticated.
#
# Both are mounted ahead of every rate limiter. Metering a probe that polls
# forever from one address would eventually return 429, and a monitor would
# read that as the server being down.
#
# See docs/UPTIMEROBOT.md for the monitor setup.
# Customer Google sign-in: OAuth Web client ID accepted for native ID tokens.
# GOOGLE_CUSTOMER_WEB_CLIENT_ID=

# Local development only: public shop/owner JPG/PNG photos saved on this computer.
# Disabled in production; customer documents and KYC still use protected cloud storage.
# LOCAL_SHOP_PHOTOS=true

# Local development only: store print documents privately on this computer.
# LOCAL_DOCUMENTS=true
